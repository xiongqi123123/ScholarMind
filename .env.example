# Connections and secrets. Copy to .env (never commit it).
# postgresql:// URLs are used with the psycopg 3 driver.
DATABASE_URL=postgresql://scholarmind:CHANGE_ME@localhost:5432/scholarmind
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
# Signs session cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false
# Outbound proxy for arXiv, if needed (standard variables, read by urllib).
# HTTPS_PROXY=http://proxy.example:7890
# Model API key, handed to pi (see analysis.base_url in config.yaml).
LLM_API_KEY=CHANGE_ME
# Writable directory for pi's config; models.json there is generated from config.yaml.
# Defaults to .cache/pi-agent in the repository. Never point it at your own ~/.pi/agent.
# PI_CODING_AGENT_DIR=/app/pi-agent
# Prompt templates, defaults to prompts/ in the repository.
# PROMPTS_DIR=/app/prompts
# Built web app, defaults to frontend/dist in the repository; not served if missing.
# FRONTEND_DIR=/app/frontend
