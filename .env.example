# Connections and secrets. Copy to .env (never commit it). No quotes, no spaces around =.
# Generate each password and SECRET_KEY with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Passwords go into connection URLs: keep to letters, digits, - and _.

# With docker compose: the database and Redis passwords, from which compose builds the
# connection URLs. POSTGRES_PASSWORD takes effect when the database volume is first created;
# changing it later also needs ALTER USER in the database.
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
# Without compose (docker run with your own PostgreSQL and Redis, or local development): the
# connection URLs instead; compose overrides these. postgresql:// URLs use the psycopg 3 driver.
# DATABASE_URL=postgresql://scholarmind:CHANGE_ME@localhost:5432/scholarmind
# REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# Signs session cookies.
SECRET_KEY=CHANGE_ME
# Model API key, handed to pi (see analysis.base_url in config.yaml).
LLM_API_KEY=CHANGE_ME
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false
# Outbound proxy for arXiv, if needed (standard variables, read by urllib). With compose, the
# build passes them to pip and npm too; pulling base images uses the Docker daemon's settings.
# HTTPS_PROXY=http://proxy.example:7890
# HTTP_PROXY=http://proxy.example:7890

# docker compose only (with docker run, pass -e ANALYZE_WORKERS=... -e TZ=...).
# Analyze workers: about 150 MB each at work, 400 MB while writing a report.
# ANALYZE_WORKERS=2
# Time zone of the scheduled jobs (sync.cron and the others in config.yaml).
# TZ=Asia/Shanghai
# Package sources for the build, tried in turn, separated by commas; default the official ones.
# PIP_INDEXES=https://pypi.tuna.tsinghua.edu.cn/simple,https://pypi.org/simple
# NPM_REGISTRIES=https://registry.npmmirror.com,https://registry.npmjs.org

# Paths, for local development (the image sets its own).
# Writable directory for pi's config; models.json there is generated from config.yaml.
# Defaults to .cache/pi-agent in the repository. Never point it at your own ~/.pi/agent.
# PI_CODING_AGENT_DIR=/app/pi-agent
# Prompt templates, defaults to prompts/ in the repository.
# PROMPTS_DIR=/app/prompts
# Built web app, defaults to frontend/dist in the repository; not served if missing.
# FRONTEND_DIR=/app/frontend
